# This is a standard Unity .gitignore file
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/

# MemoryCaptures can get huge
/[Mm]emoryCaptures/

# Asset meta data should be tracked, but temporary asset caches shouldn't
/[Aa]ssets/[Cc]ache/

# Visual Studio / VS Code generated files
/.vs/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.unityproj
*.DS_Store